// SkillPassport — database schema (PostgreSQL, Prisma ORM 7)
//
//   npm run db:migrate    create/apply a migration after editing this file (dev)
//   npm run db:deploy     apply pending migrations (production / CI)
//   npm run db:studio     browse data in Prisma Studio
//   npm run db:generate   regenerate the typed client (also runs on npm install)

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // Connection URL comes from DATABASE_URL via prisma.config.ts
}

/// What a contact-form message is about (ids match `contactTopics` in data/pages.ts).
enum ContactTopic {
  CANDIDATES  @map("candidates")
  EMPLOYERS   @map("employers")
  VERIFIERS   @map("verifiers")
  REVIEWERS   @map("reviewers")
  ENTERPRISES @map("enterprises")
  OTHER       @map("other")

  @@map("contact_topic")
}

/// Team workflow state of a message.
enum ContactStatus {
  NEW      @map("new")
  READ     @map("read")
  REPLIED  @map("replied")
  ARCHIVED @map("archived")

  @@map("contact_status")
}

/// Result of the notification + confirmation emails.
enum DeliveryStatus {
  PENDING        @map("pending")
  SENT           @map("sent")
  PARTIAL        @map("partial")
  FAILED         @map("failed")
  NOT_CONFIGURED @map("not_configured")

  @@map("delivery_status")
}

/// A message sent through the website contact form.
/// Field limits mirror the zod schema in lib/contact/schema.ts.
model ContactMessage {
  /// Primary key (generated by Postgres)
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Human-friendly reference shown to the visitor, e.g. SP-20261120-4C3341
  reference      String         @unique @db.VarChar(32)
  name           String         @db.VarChar(80)
  /// Stored lower-cased
  email          String         @db.VarChar(254)
  organization   String?        @db.VarChar(120)
  topic          ContactTopic
  subject        String         @db.VarChar(140)
  message        String         @db.Text
  /// Must be true (CHECK constraint in the init migration).
  /// name / email / subject / message also have *_not_blank_check CHECKs (contact_hardening migration).
  consent        Boolean
  status         ContactStatus  @default(NEW)
  deliveryStatus DeliveryStatus @default(PENDING) @map("delivery_status")
  deliveryDetail String?        @map("delivery_detail") @db.VarChar(1000)
  /// Client IP (IPv4/IPv6); NULL when unknown or invalid
  ip             String?        @db.Inet
  userAgent      String?        @map("user_agent") @db.VarChar(300)
  referer        String?        @db.VarChar(300)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([createdAt(sort: Desc)], map: "contact_messages_created_at_idx")
  @@index([email], map: "contact_messages_email_idx")
  /// Inbox query: WHERE status = ... ORDER BY created_at DESC (also covers status-only filters)
  @@index([status, createdAt(sort: Desc)], map: "contact_messages_status_created_at_idx")
  @@map("contact_messages")
}
