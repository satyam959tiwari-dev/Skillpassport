# ─────────────────────────────────────────────────────────────
# Contact form (app/api/contact) — copy to .env.local and fill in.
# Without SMTP settings, messages are still saved but no email is sent.
# ─────────────────────────────────────────────────────────────

# PostgreSQL (Prisma) — model ContactMessage → table contact_messages (prisma/schema.prisma)
# Local:  DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/skillpassport
# Neon:   DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-cool-name-123456-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# After setting it: `npm run db:migrate` (dev) or `npm run db:deploy` (production).
# Leave empty to store submissions in ./.data/contact-submissions.jsonl instead.
DATABASE_URL=
# Max pooled connections per server instance
DATABASE_POOL_MAX=5

# SMTP server (any provider: Gmail/Google Workspace app password, Zoho, Microsoft 365,
# Brevo, SendGrid, Amazon SES, Resend SMTP…)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# true for port 465 (implicit TLS); leave empty to auto-detect from the port
SMTP_SECURE=
SMTP_USER=your-mailbox@yourdomain.com
SMTP_PASS=your-app-password

# Where new inquiries are delivered (comma-separate for multiple inboxes)
CONTACT_TO_EMAIL=team@yourdomain.com
# Sender shown on both emails (must be allowed by your SMTP provider; defaults to SMTP_USER)
CONTACT_FROM_EMAIL=no-reply@yourdomain.com
CONTACT_FROM_NAME=SkillPassport
# Where visitors' replies to the confirmation email go (defaults to CONTACT_TO_EMAIL)
CONTACT_REPLY_TO=
# Set to "false" to skip the automatic confirmation email to the visitor
CONTACT_SEND_CONFIRMATION=true

# Spam protection (per IP, in-memory): max submissions per window
CONTACT_RATE_LIMIT=5
CONTACT_RATE_WINDOW_MS=600000

# JSONL storage directory (used only when DATABASE_URL is empty, or as fallback if the DB is down).
# Defaults to ./.data, falls back to the OS temp dir.
CONTACT_STORE_DIR=

# Only for `npm run build:static`: the static site posts to this deployed API instead,
# and the API must allow the static site's origin.
NEXT_PUBLIC_CONTACT_ENDPOINT=
CONTACT_ALLOWED_ORIGINS=
